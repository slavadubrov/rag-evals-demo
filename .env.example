# OpenAI only. Copy without overwriting an existing .env.
OPENAI_API_KEY=
RAG_EVALS_DEFAULT_MODEL=gpt-5.6-luna
RAG_EVALS_JUDGE_MODEL=gpt-5.6-luna
RAG_EVALS_THIRD_JUDGE=gpt-5.6-terra
# Library default is mock; CLI needs --live for model evaluation.
RAG_EVALS_BACKEND=mock
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_MAX_CALLS=200
REASONING_EFFORT=low

# Embedded Qdrant; use a new path/collection to rebuild an existing index.
# QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./qdrant_storage
QDRANT_COLLECTION=scifact
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Illustrative only. Applied with --quality-gates; calibrate on your own dev set.
THRESHOLD_RECALL_AT_10=0.85
THRESHOLD_MRR=0.6
THRESHOLD_FILTER_FALSE_EXCLUSION=0.02
THRESHOLD_FAITHFULNESS=0.85
