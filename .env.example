# --- Qdrant ---
# By default the demo uses embedded Qdrant (a local file at QDRANT_PATH).
# Uncomment QDRANT_URL to talk to your own Qdrant server instead.
# QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./qdrant_storage
QDRANT_COLLECTION=scifact

# --- LLM (LiteLLM-routed) ---
# Models are selected via the rag_evals.generation.models.Model enum.
# Set the keys for the providers you want; the rest fall back to MockBackend.
RAG_EVALS_DEFAULT_MODEL=gpt-5-mini
RAG_EVALS_JUDGE_MODEL=claude-haiku-4-5
RAG_EVALS_THIRD_JUDGE=gemini/gemini-2.5-flash

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# auto = use live LLM if the matching API key is set, else MockBackend.
# mock = force deterministic offline stub (used in CI / notebooks).
# live = require live LLM; raise if key is missing.
RAG_EVALS_BACKEND=auto

# --- Models (Hugging Face cache) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# --- Eval thresholds (used by `make eval` to fail-on-regress) ---
THRESHOLD_RECALL_AT_10=0.85
THRESHOLD_MRR=0.6
THRESHOLD_FILTER_FALSE_EXCLUSION=0.02
THRESHOLD_FAITHFULNESS=0.85
